<Project Sdk="Microsoft.NET.Sdk">
  <!-- volume-helper.exe for "Lower other apps while friends talk": .NET Framework 4.8, no libraries.
       Built on Windows by .github/workflows/pages.yml into client/, next to re4-helper.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>volume-helper</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
